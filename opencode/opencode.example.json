{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "example-server": {
      "type": "local",
      "command": ["npx", "-y", "example-mcp-server"],
      "enabled": true,
      "environment": {
        "EXAMPLE_TOKEN": "{env:EXAMPLE_TOKEN}",
        "EXAMPLE_BASE_URL": "https://example.atlassian.net"
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/git/**": "allow"
    }
  }
}
